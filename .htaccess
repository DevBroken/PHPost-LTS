# ----------------------------------------------------------------------
# SEGURIDAD BÁSICA Y PROTECCIÓN DE ARCHIVOS
# ----------------------------------------------------------------------

# Prevenir el listado de directorios (evita que vean tus archivos si no hay un index)
Options -Indexes

# Desactivar firmas del servidor (no mostrar versión de Apache en errores)
ServerSignature Off

# Proteger el propio archivo .htaccess y archivos de configuración sensibles
<FilesMatch "^(\.htaccess|\.git|config\.php|inc\..*)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# CABECERAS DE SEGURIDAD (Meticulosamente profesionales)
# ----------------------------------------------------------------------
<IfModule mod_headers.module>
    # Mitigar ataques XSS bloqueando la ejecución si se detecta un reflejo
    Header set X-XSS-Protection "1; mode=block"

    # Prevenir que el sitio sea enmarcado (evita Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevenir que el navegador adivine el Content-Type (evita sniffing de MIME-types maliciosos)
    Header set X-Content-Type-Options "nosniff"

    # Política de Referrer segura
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# OPTIMIZACIÓN DE REESCRITURA (Motor URL de PHPost)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Definir la base (ajustar si PHPost corre en un subdirectorio)
    RewriteBase /

    # Regla para assets (Mapea /assets/... a /frontend/assets/...)
    RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -f
    RewriteRule ^media/(assets/.+)$ frontend/$1 [L]

    # Regla para themes (Mapea /nombre_del_theme/... a /frontend/themes/nombre_del_theme/...)
    # Esta regla verifica si el archivo existe dentro de la carpeta frontend/themes/
    RewriteCond %{DOCUMENT_ROOT}/frontend/themes/$1 -f
    RewriteRule ^media/([^/]+/.+)$ frontend/themes/$1 [L]

    # Reglas heredadas del PHPost original reestructuradas de forma limpia
    RewriteRule ^$ index.php?do=home [QSA,L]
    RewriteRule ^posts/$ index.php?do=home [QSA,L]
    RewriteRule ^pagina([0-9]+)$ index.php?page=$1 [QSA,L]
    RewriteRule ^index.php$ index.php?do=home [QSA,L]
    RewriteRule ^cuenta.php$ inc/php/cuenta.php [QSA,L]
    RewriteRule ^cuenta/([A-Za-z0-9_-]+)$ inc/php/cuenta.php?accion=$1 [QSA,L]
    RewriteRule ^agregar.php$ inc/php/agregar.php [QSA,L]

    # PAGINACION POSTS
    RewriteRule ^page/([0-9]+)$ index.php?do=home&page=$1 [QSA,L]
    RewriteRule ^cursor/([A-Za-z0-9_-]+)$ index.php?do=home&cursor=$1 [QSA,L]
    # PAGINACION CATEGORIAS
    RewriteRule ^c/([A-Za-z_-]+)/page/([0-9]+)$ index.php?do=home&categoria=$1&page=$2 [QSA,L]
    RewriteRule ^c/([A-Za-z_-]+)/cursor/([A-Za-z0-9_-]+)$ index.php?do=home&categoria=$1&cursor=$2 [QSA,L]

    # PORTAL
    RewriteRule ^mi/$ index.php?do=portal [QSA,L]

    # CATEGORIAS
    RewriteRule ^c/([A-Za-z_-]+)$ index.php?do=home&categoria=$1 [QSA,L]

    # Sin usar ID
    RewriteRule ^c/([A-Za-z_-]+)/([A-Za-z0-9_-]+)$ inc/php/posts.php?do=posts&categoria=$1&title=$2 [QSA,L]
    RewriteRule ^/posts/(random|prev|next)/([0-9]+)$ inc/php/posts.php?action=$1&id=$2 [QSA,L]

    # ACCIONES
    RewriteRule ^posts/editar/([0-9]+)$ inc/php/agregar.php?action=editar&pid=$1 [QSA,L]

    #PERFIL
    RewriteRule ^perfil/([A-Za-z0-9_-]+)$ inc/php/perfil.php?user=$1 [QSA,L]
    RewriteRule ^perfil/([A-Za-z0-9_-]+)/$ inc/php/perfil.php?user=$1 [QSA,L]
    RewriteRule ^perfil/([A-Za-z0-9_-]+)/([0-9]+)$ inc/php/perfil.php?user=$1&pid=$2 [QSA,L]

    # RECUPERAR PASS Y VALIDAR CUENTA
    RewriteRule ^password/(.+)/([0-9]+)/(.+)/?$ inc/php/password.php?hash=$1&type=$2&email=$3
    RewriteRule ^validar/(.+)/([0-9]+)/(.+)/?$ inc/php/password.php?hash=$1&type=$2&email=$3

    # FOTOS
    RewriteRule ^fotos/([A-Za-z0-9_-]+).php$ inc/php/fotos.php?action=$1 [QSA,L]
    RewriteRule ^fotos/([A-Za-z0-9_-]+)$ inc/php/fotos.php?action=album&user=$1 [QSA,L]
    RewriteRule ^fotos/([A-Za-z0-9_-]+)/([0-9]+)$ inc/php/fotos.php?action=album&user=$1&page=$2 [QSA,L]
    RewriteRule ^fotos/([A-Za-z0-9_-]+)/([0-9]+)/([A-Za-z0-9_-]+).html$ inc/php/fotos.php?action=ver&user=$1&fid=$2 [QSA,L]

    # ADMIN
    RewriteRule ^admin/afs/editar/([0-9]+)$ inc/php/admin.php?action=afs&act=editar&aid=$1 [QSA,L]
    RewriteRule ^admin/medals/editar/([0-9]+)$ inc/php/admin.php?action=medals&act=editar&mid=$1 [QSA,L]
    RewriteRule ^admin/medals/nueva inc/php/admin.php?action=medals&act=nueva [QSA,L]
    RewriteRule ^admin/news/editar/([0-9]+)$ inc/php/admin.php?action=news&act=editar&nid=$1 [QSA,L]
    RewriteRule ^admin/news/nueva inc/php/admin.php?action=news&act=nuevo [QSA,L]

    # MODERACIÓN
    RewriteRule ^moderacion/buscador/([0-2]+)/([0-2]+)/([A-Za-z0-90.9.:a_zA_z_+_%20_¿?¡!@,'-]+)$ inc/php/moderacion.php?action=buscador&act=search&m=$1&t=$2&texto=$3 [QSA,L]

    #HISTORIAL DE MODERACIÓN
    RewriteRule ^mod-history/([A-Za-z0-9_-]+)/ inc/php/mod-history.php?ver=$1 [QSA,L]

    # AUTENTICACION & REGISTRO
    RewriteRule ^auth/([a-z]+)$ inc/php/auth.php?action=$1 [QSA,L]

    # AJAX
    RewriteRule ^api/([A-Za-z0-9_-]+)$ inc/ajax/index.php?action=$1 [QSA,L]
    RewriteRule ^([A-Za-z0-9_-]+)(\.php)$ inc/ajax/index.php?action=$1 [QSA,L]

    #EXTRAS
    RewriteRule ^([A-Za-z0-9_-]+)/$ inc/php/$1.php [QSA,L]
    RewriteRule ^([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)$ inc/php/$1.php?action=$2 [QSA,L]
    RewriteRule ^([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)/$ inc/php/$1.php?action=$2 [QSA,L]
    RewriteRule ^([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)/([0-9]+)$ inc/php/$1.php?action=$2&id=$3 [QSA,L]
</IfModule>